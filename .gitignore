# Local student rosters can contain passwords or TAP values.
students/*.csv
samples/*.csv

# Raw tenant telemetry captures. The whole directory is ignored, not just *.csv:
# the cache is moving to NDJSON so that nested dynamic columns survive the round
# trip, and an extension-specific rule would have silently stopped covering it.
# Test-RepositorySafety.ps1 blocks '^sample/' as the second layer.
sample/

# Dated tenant telemetry exports (real DIBSecCom user, device, and IP data).
# Produced by scripts/Export-TenantTelemetrySamples.ps1.
sample/*Z/

# Local environment and logs.
.env
compose.override.yaml
.cf-config
*.log
data/backups/
data/local-export/
data/local-kusto/

# Generated telemetry. Reproduced deterministically by
# scripts/New-SyntheticTelemetry.ps1 from schemas/ and metadata/field-profiles/,
# so the ~900 MB of NDJSON does not belong in the repository. data/scenario-summary.json
# stays tracked because it documents the scenario rather than carrying bulk data.
data/generated/

# Python virtual environment.
.venv/
__pycache__/
*.pyc

# Cloudflare Terraform state and local deployment values.
infra/cloudflare-adx/.terraform/
infra/cloudflare-adx/*.tfstate
infra/cloudflare-adx/*.tfstate.*
infra/cloudflare-adx/*.tfplan
infra/cloudflare-adx/terraform.tfvars
infra/cloudflare-adx/allowed-emails.txt
infra/cloudflare-adx/allowed-emails.auto.tfvars.json
infra/cloudflare-adx/cloudflared.env
infra/cloudflare-adx/student-access.env

# OS/editor noise.
.DS_Store
Thumbs.db
.vscode/
