#!/bin/sh
#
# Blocks real tenant data and bulk generated output from entering the repository.
#
# All rules live in scripts/Test-RepositorySafety.ps1, which CI also runs, so the
# hook and CI enforce the same rules by construction. In -Staged mode the script
# checks the staged paths (including students/, samples/, and data/generated/) and
# scans the staged blob *contents* of any field profile -- not the working tree, so
# "git add then edit" cannot slip different content past the hook.
#
# Install with: pwsh -NoProfile -File scripts/Install-WorkshopGitHooks.ps1
# Bypass is possible with --no-verify, and is never appropriate for these rules.

if command -v pwsh >/dev/null 2>&1; then
    :
else
    echo "COMMIT BLOCKED: PowerShell 7 (pwsh) is required to run the repository safety checks." >&2
    echo "Install it, or review scripts/Test-RepositorySafety.ps1 and run it manually." >&2
    exit 1
fi

pwsh -NoProfile -File "scripts/Test-RepositorySafety.ps1" -Staged
exit $?
